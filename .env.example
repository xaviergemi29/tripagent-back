# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Conexión a PostgreSQL (Neon). SSL obligatorio.
DATABASE_URL=

# Puerto HTTP de la API (por defecto 3001; el front apunta a http://localhost:3001/api).
PORT=3001

# Conexiones del pool de Postgres POR INSTANCIA (por defecto 10). Con varias instancias usa el
# endpoint con pooler de Neon (host con "-pooler") y reparte el límite entre ellas.
# DB_POOL_MAX=10

# Secretos de sesión: OBLIGATORIOS (la API no arranca sin ellos), mínimo 32 caracteres y distintos.
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cambiarlos invalida todas las sesiones activas (los usuarios vuelven a iniciar sesión).
JWT_SECRET=
COOKIE_SECRET=

# Orígenes del front que pueden llamar a la API con la cookie de sesión, separados por comas.
# OBLIGATORIO en producción (NODE_ENV=production). En desarrollo, si se omite, se permiten
# localhost y las IPs de red privada (192.168.x.x, 10.x.x.x, 172.16-31.x.x).
# CORS_ORIGINS=https://app.tripagent.mx

# Solo detrás de un proxy o balanceador: número de saltos de confianza ("1") o IPs/CIDR.
# Sin esto, el límite de intentos usa la IP del proxy para todos los clientes.
# TRUST_PROXY=1

# Opcional. Mismo valor en el front (variable de servidor, nunca NEXT_PUBLIC_), >= 32 caracteres.
# El servidor de Next lo usa para reenviar la IP del visitante en /p/[id], /register y /s/[token];
# sin esto, el límite de intentos de esas rutas es uno solo para todos los visitantes.
# INTERNAL_PROXY_SECRET=

# production activa la cookie Secure y HSTS.
# NODE_ENV=production

# Cobro de la suscripción de TripAgent (Configuración → Suscripción). Son los datos de TripAgent,
# no de la agencia. Opcionales: si faltan o son inválidos, el front oculta ese canal de pago.
SUBSCRIPTION_SPEI_BANK="BBVA Bancomer"
SUBSCRIPTION_SPEI_BENEFICIARY="TripAgent"
SUBSCRIPTION_SPEI_CLABE=012180000000000000
# Payment Link de Stripe (https). El front agrega ?client_reference_id=<agencyId>.
# SUBSCRIPTION_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# WhatsApp de soporte para enviar el comprobante SPEI, con lada (p. ej. 52 + 10 dígitos).
SUBSCRIPTION_WHATSAPP_NUMBER=522281234567
