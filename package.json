{
  "name": "tripagent-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tenant:create": "tsx src/db/seed-admin.ts",
    "vehicle-templates:sync": "tsx src/db/sync-vehicle-templates.ts",
    "phones:normalize": "tsx src/db/normalize-phones.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "libphonenumber-js": "1.13.15",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
